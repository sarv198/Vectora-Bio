# Copy to cellscope/.env to override defaults.
# With no DATABASE_URL, the API uses a SQLite file at backend/cellscope.db.
# Relative DATA_* paths are resolved from the cellscope/ directory.

# DATABASE_URL=postgresql+psycopg://cellscope:cellscope@localhost:5432/cellscope
# DATA_RAW_DIR=./data/raw
# DATA_PROCESSED_DIR=./data/processed

# Used by docker-compose.yml for the local Postgres service.
POSTGRES_USER=cellscope
POSTGRES_PASSWORD=cellscope
POSTGRES_DB=cellscope

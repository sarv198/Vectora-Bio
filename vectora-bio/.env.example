# Copy to vectora-bio/.env. Environment variables override values in this file.
# Relative DATA_* paths are resolved from the vectora-bio/ directory.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (see scripts/setup_postgres.sql). Use your own password.
DATABASE_URL=postgresql+psycopg://vectora:change-me@localhost:5432/vectora
AUTO_CREATE_TABLES=true
PERSIST_ANALYSIS_RUNS=true

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
# Relative to DATA_PROCESSED_DIR unless absolute.
# COMPOUND_PROFILES_FILE=profiles/compound_profiles.parquet
# GENETIC_PROFILES_FILE=profiles/genetic_profiles.parquet
# CONTROL_PROFILES_FILE=profiles/control_profiles.parquet

# Replicate aggregation for consensus profiles: median or mean.
CONSENSUS_METHOD=median
MAX_TOP_K=500

# Used by docker-compose.yml for its Postgres service.
POSTGRES_USER=vectora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vectora
